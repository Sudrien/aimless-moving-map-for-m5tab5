# The moving map's configuration. Most lines are ones the player
# (defeatist-music-player-for-m5tab5) and the analyzer set for the same
# reasons; the player's sdkconfig.defaults has the full argument for each.
#
# sdkconfig.defaults only fills keys an existing sdkconfig lacks, so a
# change here needs `rm sdkconfig` before the next build.

CONFIG_IDF_TARGET="esp32p4"
# Tab5 silicon is ESP32-P4 rev v1.3. Without this the build targets rev
# v3.1+ and esptool refuses to flash.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The four 1280 px tiles (13 MB), the shadow framebuffer and the render
# buffers are in PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# app_main renders tiles; the decoder and rasteriser keep their scratch on
# the heap, but the call chain is deep.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# The Ark12 font table is large; the default 1 MB app partition is not.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The card and a USB drive, with long names.
CONFIG_FATFS_VOLUME_COUNT=2
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
# Without fast seek every f_lseek() on a large archive walks the FAT chain:
# about 500 ms a seek, measured by the original (its bigfile.cpp).
CONFIG_FATFS_USE_FASTSEEK=y
